APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Keep infrastructure and secrets environment-specific.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blijwincontent
